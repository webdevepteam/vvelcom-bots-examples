VVELCOM_BOT_TOKEN=vv_ваш_токен
VVELCOM_CHANNEL=@ник_вашего_канала
CHANNELS_JSON=["https://t.me/s/your_channel"]
KEYWORDS_JSON=[]
LOOKBACK_MINUTES=70
SQLITE_RETENTION_DAYS=60
MAX_POSTS_PER_CHANNEL=50
REQUEST_TIMEOUT_MS=7000
SQLITE_PATH=/function/storage/telegram-news-monitor/telegram-monitor.sqlite

# Прокси вне РФ для t.me (если из Yandex Cloud Telegram недоступен)
# TELEGRAM_PROXY_URL=http://user:pass@host:3128

# Relay на сервере с доступом к Telegram (приоритетнее прокси)
# RELAY_URL=https://relay.example.com/v1/request
# RELAY_TOKEN=тот же, что RELAY_SERVICE_TOKEN на сервере
