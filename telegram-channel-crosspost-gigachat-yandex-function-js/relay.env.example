# Секрет для доступа к relay: длинная случайная строка (например, `openssl rand -hex 32`).
RELAY_SERVICE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Домены (и их поддомены), к которым relay имеет право ходить.
# t.me — страницы каналов, telesco.pe и cdn-telegram.org — фото из постов.
ALLOWED_HOSTS=api.telegram.org,t.me,telesco.pe,cdn-telegram.org
PORT=9010
# Куда писать лог (по умолчанию relay.log рядом с restricted_relay.py).
LOG_FILE=/home/relay.log
