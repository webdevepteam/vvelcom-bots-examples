VVELCOM_BOT_TOKEN=vv_ваш_токен
VVELCOM_CHANNEL=@ник_вашего_канала
CHANNELS_JSON=["https://t.me/s/your_channel"]
KEYWORDS_JSON=[]
LOOKBACK_MINUTES=70
SQLITE_RETENTION_DAYS=60
MAX_POSTS_PER_CHANNEL=50
REQUEST_TIMEOUT_MS=7000
SQLITE_PATH=/function/storage/telegram-news-monitor/telegram-monitor.sqlite

# Прокси вне РФ для t.me (если из Yandex Cloud Telegram недоступен)
# TELEGRAM_PROXY_URL=http://user:pass@host:3128

# Relay на сервере с доступом к Telegram (приоритетнее прокси)
# RELAY_URL=https://relay.example.com/v1/request
# RELAY_TOKEN=тот же, что RELAY_SERVICE_TOKEN на сервере

# --- GigaChat ---
# Ключ авторизации (Base64) из личного кабинета Сбера — хранить в Lockbox
GIGACHAT_AUTH_KEY=ключ_авторизации
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat = Lite; можно GigaChat-Pro / GigaChat-Max
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT_MS=8000
# Российский корневой сертификат (PEM), положите файл рядом с index.js
GIGACHAT_CA_PATH=./russian_trusted_root_ca.pem
# GIGACHAT_INSECURE_TLS=true   # только если сертификат подключить нельзя

# ИИ-фильтр: что искать в постах. Пусто — фильтр выключен
AI_FILTER_PROMPT=Пост про выход новых смартфонов или анонс их характеристик

# Чат-бот (webhook)
VVELCOM_WEBHOOK_SECRET=случайная_строка
# BOT_USERNAME=my_vvbot   # если getMe не вернул ник
CHAT_SYSTEM_PROMPT=Ты полезный русскоязычный помощник. Отвечай понятно и кратко.


# Модель для ответов в чате (не задана — как GIGACHAT_MODEL). Для умнее: GigaChat-2-Pro / GigaChat-2-Max
# CHAT_GIGACHAT_MODEL=GigaChat-2-Pro
# Дата окончания бесплатных токенов из личного кабинета — показывается в /balance
# GIGACHAT_TOKENS_EXPIRES=2027-10-09

# Длина ответа в чате (токены): короче — быстрее генерация и больше шансов уложиться в 10 с вебхука
# CHAT_MAX_TOKENS=500

# Ограничители расхода токенов (счётчики в памяти контейнера, при холодном старте обнуляются)
# CHAT_MAX_INPUT_CHARS=1500        # макс. символов вопроса и каждого блока контекста (пост, цитата)
# CHAT_USER_LIMIT_PER_HOUR=10      # вопросов в час от одного пользователя, 0 — без лимита
# CHAT_DAILY_TOKEN_LIMIT=200000    # дневной бюджет токенов на чат, 0 — без лимита
# AI_FILTER_MAX_CHARS=2000         # макс. символов поста для ИИ-фильтра

# Ответ в чате готовит асинхронный вызов этой же функции (?integration=async), вебхук не держится.
# Сколько ждать GigaChat там, мс. Таймаут функции в Yandex Cloud — не меньше этого значения + 5 с (лучше 90 с).
# CHAT_ANSWER_TIMEOUT_MS=40000
