# Обязательно: токен Вашего бота @VVbotMother, только в env Яндекс-функции
VVELCOM_BOT_TOKEN=vv_REPLACE_WITH_BOT_TOKEN
# Origin игры без пути, например https://storage.yandexcloud.net
ALLOWED_ORIGINS=https://storage.yandexcloud.net
# HTTPS-адрес index.html: кнопка «Играть» и «Играть в раунд»
GAME_URL=https://storage.yandexcloud.net/YOUR_BUCKET/index.html
# Секрет webhook, например: openssl rand -hex 24
VVELCOM_WEBHOOK_SECRET=GENERATE_RANDOM_SECRET
# Папка подключённого хранилища (Object Storage bucket, смонтированный в функцию), по умолчанию:
QUIZ_STORAGE_DIR=/function/storage/quiz-vv-app
# Необязательно: ник бота для приглашений в ленте и сколько часов раунд принимает результаты (по умолчанию 24)
QUIZ_BOT_LINK=@quiz_vvbot
ROUND_HOURS=24
