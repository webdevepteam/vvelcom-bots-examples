# Токен бота от @VVbotMother — хранить в Lockbox
VVELCOM_BOT_TOKEN=vv_ваш_токен
# Секрет вебхука (secret_token в setWebhook): openssl rand -hex 32
VVELCOM_WEBHOOK_SECRET=случайная_строка

# GigaChat: «Ключ авторизации» из личного кабинета (developers.sber.ru/studio) — хранить в Lockbox
GIGACHAT_AUTH_KEY=ключ_авторизации
# Тип доступа: GIGACHAT_API_PERS (физлицо), GIGACHAT_API_B2B, GIGACHAT_API_CORP. Пусто — определить по ключу
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat (Lite), GigaChat-Pro, GigaChat-Max, GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max
GIGACHAT_MODEL=GigaChat

# Какие списки вести — инструкция модели (формат ответа добавляется в коде сам).
# Пусто — покупки и дела. Перевод строки — \n. Длинный текст — в файл и BOT_PROMPT_FILE
# (у переменных функции общий лимит 4 КБ).
# BOT_PROMPT=Ты ведёшь список покупок для семьи. Название списка — «Список покупок», эмодзи 🛒. В note — количество.
# BOT_PROMPT_FILE=./prompt.txt
# Первая строка /help — для чего бот. Пусто — текст по умолчанию.
# BOT_ABOUT=🛒 Я веду список покупок нашей семьи.

# Только эти чаты (через запятую). Пусто — любой чат. ID чата бот пишет сам, если его там нет в списке.
# ALLOWED_CHAT_IDS=7eb76e3b-28c4-470d-b799-7c540e4972fc

# Папка примонтированного бакета Object Storage (списки и статистика)
DATA_DIR=/function/storage/shopping
# Сколько последних списков хранить в чате (старые удаляются)
LISTS_KEEP=10

# Ник бота без @ (если не задан — берётся из getMe)
# BOT_USERNAME=family_lists_vvbot
# Часовой пояс для дат списков
TIME_ZONE=Europe/Moscow

# Российский корневой сертификат для GigaChat (PEM рядом с index.js)
GIGACHAT_CA_PATH=./russian_trusted_root_ca.pem
# GIGACHAT_INSECURE_TLS=true   # только если сертификат подключить нельзя
GIGACHAT_TIMEOUT_MS=30000
# Предел длины ответа модели при разборе списка (токены)
LIST_MAX_TOKENS=1500
